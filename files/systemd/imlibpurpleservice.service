# Keep the IM transport resident. com.palm.imlibpurple is normally an on-demand LS2 service that
# the hub idle-reaps after 30s, which takes every connector with it: a pushed message in the
# down-window is lost, and an interactive sign-in (Telegram asks for a code and waits for a human)
# cannot finish. Measured: account enabled 15:59:43, "shutting down in 30 seconds" the same
# second, stopped 16:00:13, login nowhere.
#
# The systemd half of files/etc/event.d/imtransport, which is upstart and so does not apply here.

[Unit]
Description=Keep the libpurple IM transport resident for pushed messages
Requires=ls-hubd.service
After=ls-hubd.service db8-maindb.service db8-tempdb.service activitymanager.service
# After= is ordering only, so keep the restart budget generous for db8/activitymanager not yet
# being up - matching the upstart job's "respawn limit 30 3600".
StartLimitIntervalSec=3600
StartLimitBurst=30

[Service]
Type=simple
# Root, as the hub launches it: reads /etc/palm, writes the account stores.
User=root

# The switch IMServiceHandler::OkToShutdown() reads. Without it this unit's Restart= and the
# transport's own idle shutdown fight in a ~30s loop that reloads every prpl each cycle.
Environment=IM_RESIDENT=1

# libPmLogLib takes a one-time init lock on /dev/shm/sem.PmLogLib. A transport killed mid-init
# leaves it locked and every later one blocks forever on its first PmLog call. Unlinking is safe:
# sem_open makes a fresh one and existing holders keep their handle.
ExecStartPre=-/bin/rm -f /dev/shm/sem.PmLogLib

# The same invocation as files/sysbus/com.palm.imlibpurple.service.in, so the transport cannot
# tell which way it started. Raise "info" to "debug", and add IM_PURPLE_DEBUG=1 for prpl debug,
# while chasing a connector - both flood a resident daemon.
ExecStart=/usr/sbin/imlibpurpleservice -c {\"log\":{\"appender\":{\"type\":\"pmlog\"},\"levels\":{\"imlibpurple\":\"info\"}}} PalmPre Palm-Pre/1.5

Restart=always
RestartSec=5
# Give connectors (Signal's in-process JVM, WhatsApp's contact sync) time to disconnect cleanly
# before SIGKILL.
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
